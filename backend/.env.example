PORT=5001
SQLITE_DB_PATH=./data/educationadvisor-web.sqlite
JWT_ACCESS_SECRET=change-this-secret
JWT_ACCESS_EXPIRES_IN=1d
APP_BASE_URL=http://localhost:3000

AUTH_DEBUG_RETURN_RESET_TOKEN=true
REQUEST_LOG_ENABLED=true
METRICS_ENABLED=true

AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_QA_ENDPOINT_PATH=/api/ai/qa/ask
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=20000
AI_PYTHON_EXECUTABLE=
GOOGLE_API_KEY=

DEV_SEED_USER_ENABLED=true
DEV_SEED_USER_EMAIL=dev@example.com
DEV_SEED_USER_PASSWORD=12345678
DEV_SEED_USER_NAME=Dev User

SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=SuperAdmin@123
SUPERADMIN_NAME=System Superadmin
