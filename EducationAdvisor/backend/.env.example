# Application
ENVIRONMENT=development
APP_NAME=Admission Planner
APP_VERSION=0.1.0
DEBUG=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/admission_planner
MONGODB_URL=mongodb://localhost:27017
DB_NAME=admission_planner

# Redis
REDIS_URL=redis://localhost:6379
QA_CACHE_ENABLED=True
QA_CACHE_TTL_SECONDS=300
QA_CACHE_NAMESPACE=qa:answer:v1

# Vector Database
CHROMA_HOST=localhost
CHROMA_PORT=8001

# OpenAI / LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# Google Gemini (used by Embedding Model)
GOOGLE_API_KEY=your-google-api-key

# Groq (used by ChatGroq LLM in the Multi-Agent workflow)
GROQ_API_KEY=your-groq-api-key

# LlamaCloud / LlamaParse (used by Hybrid PDF Parser)
LLAMA_CLOUD_API_KEY=llx-...

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO

# Internal service-to-service auth (optional)
INTERNAL_API_KEY=
