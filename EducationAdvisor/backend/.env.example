# Application
ENVIRONMENT=development
APP_NAME=Admission Planner
APP_VERSION=0.1.0
DEBUG=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/admission_planner
MONGODB_URL=mongodb://localhost:27017
DB_NAME=admission_planner

# Redis
REDIS_URL=redis://localhost:6379

# Vector Database
CHROMA_HOST=localhost
CHROMA_PORT=8001

# OpenAI / LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
INTERNAL_API_KEY=change-me

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO
